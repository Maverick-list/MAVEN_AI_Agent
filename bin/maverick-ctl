#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

export PYTHONPATH="$PROJECT_ROOT:${PYTHONPATH:-}"

# Note: In accordance with Phase 2.2 security audit, the CLI process itself is NOT
# de-confined here. AppArmor confinement is preserved for the entire runtime.
# Only specific D-Bus method calls targeting snap.spotify.spotify are isolated and
# mediated in maverick/media/spotify.py under strict argument validation.

exec /usr/bin/python3 -m maverick.cli "$@"
